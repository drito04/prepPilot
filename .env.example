POSTGRES_DB=prepPilot
POSTGRES_USER=prepPilot
POSTGRES_PASSWORD=change-me

# Database. The Postgres container creates this database and user on first start.
DB_NAME=preppilot
DB_USER=preppilot
DB_PASSWORD=change-me

# Auth. 32+ characters, used as raw text. Core and realtime read the same value.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRY_SECONDS=7200
FRONTEND_ORIGIN=http://localhost:5173

# Email. Mailpit catches everything in development.
# Set MAIL_HOST and the other MAIL_* values only when you use a real provider.
MAIL_FROM=no-reply@preppilot.local
OTP_TTL_MINUTES=10

# Seeded accounts. Leave the passwords blank to skip seeding.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_INTERVIEWER_EMAIL=interviewer@example.com
SEED_INTERVIEWER_PASSWORD=

# Public port of the Nginx gateway.
GATEWAY_PORT=8088